{
  "compatibility_date": "2026-10-23",
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sri-veerabhadrakali-temple",
  "main": "index.mjs",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "..\\client",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.mjs",
        "**/*.js"
      ]
    }
  ]
}